@model MVC_Buddies.Dtos.PagedResult<MVC_Buddies.Dtos.AdminUserListItemDto>
@{
    ViewData["Title"] = "Users";
    string? search = ViewBag.Search as string;
    string? role = ViewBag.Role as string;
    bool? active = ViewBag.Active as bool?;
}

<h2 class="mb-3">@ViewData["Title"]</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input class="form-control" name="search" value="@search" placeholder="Search (email ou nome)" />
    </div>
    <div class="col-md-3">
        <input class="form-control" name="role" value="@role" placeholder="Role (Admin/PetOwner/PetSitter)" />
    </div>
    <div class="col-md-2">
        <select class="form-select" name="active">
            <option value="" selected="@(active is null)">Todos</option>
            <option value="true" selected="@(active == true)">Ativos</option>
            <option value="false" selected="@(active == false)">Inativos</option>
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary w-100">Filtrar</button>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped mb-0 align-middle">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Criado</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Items)
                {
                    <tr>
                        <td>@u.FullName</td>
                        <td>@u.Email</td>
                        <td>@u.Role</td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else
                            {

                                <span class="badge bg-secondary">Inativo</span>
                            }
                        </td>
                        <td>@u.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            <form asp-action="ToggleUserStatus" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@u.Id" />
                                <input type="hidden" name="isActive" value="@(!u.IsActive)" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    @(u.IsActive ? "Desativar" : "Ativar")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <span class="text-muted">Total: @Model.Total</span>
</div>
