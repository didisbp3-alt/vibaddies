@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@model MVC_Buddies.Dtos.MainViewModel

@{
    ViewData["Title"] = L["HomeTitle"];
    var city = !string.IsNullOrWhiteSpace(Model.Location) ? Model.Location : "";
}

<!-- HERO + SEARCH -->
<section class="hero hero-surface mb-3">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <h1 class="display-6 fw-bold">@L["FindIdealSitterTitle"]</h1>
            <p class="lead text-muted mb-3">@L["FindIdealSitterSubtitle"]</p>

            <div class="d-flex gap-2 flex-wrap mb-3">
                <a class="btn btn-brand" asp-controller="Home" asp-action="Search">
                    <i class="bi bi-search me-1"></i> @L["BookNow"]
                </a>
                <a class="btn btn-link text-decoration-none" asp-controller="Home" asp-action="HowItWorks">
                    @L["HowItWorks"] <i class="bi bi-arrow-right-short"></i>
                </a>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm rounded-4 border-0">
                <div class="card-body p-4">
                    <form method="get" class="row g-2">
                        <div class="col-12">
                            <label class="form-label small text-muted">@L["Location"]</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-geo-alt"></i></span>
                                <input name="location"
                                       value="@(Model?.Location ?? "")"
                                       class="form-control"
                                       type="search"
                                       placeholder="@L["LocationPlaceholder"]" />
                            </div>
                        </div>

                        <div class="col-6">
                            <label class="form-label small text-muted">@L["From Date"]</label>
                            <input name="from" class="form-control" type="date" />
                        </div>

                        <div class="col-6">
                            <label class="form-label small text-muted">@L["To Date"]</label>
                            <input name="to" class="form-control" type="date" />
                        </div>

                        <div class="col-12">
                            <label class="form-label small text-muted">@L["Service"]</label>
                            <select name="serviceId" class="form-select">
                                <option value="">@L["AnyService"]</option>

                                @foreach (var s in Model.Services)
                                {
                                    <option value="@s.Id"
                                            selected="@(Model.SelectedServiceId == s.Id)">
                                        @s.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-12 mt-2">
                            <button class="btn btn-brand w-100" type="submit">
                                <i class="bi bi-search me-1"></i> @L["SearchBtn"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="h5 mb-0">@L["Top Sitters In"] @city</h3>
    </div>

    <div class="row g-3">
        @if (Model?.Sitters == null || !Model.Sitters.Any())
        {
            <div class="col-12">
                <div class="alert alert-info mb-0">@L["No Sitters Found"]</div>
            </div>
        }
        else
        {
            foreach (var s in Model.Sitters)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <article class="card h-100 shadow-sm rounded-4 border-0 sitter-card">
                        <div class="card-body d-flex flex-column">

                            <div class="d-flex gap-3 mb-3 align-items-center">
                                <img src="@(string.IsNullOrWhiteSpace(s.AvatarUrl)
                                                                                                  ? Url.Content("~/images/avatar-placeholder.png")
                                                                                                  : s.AvatarUrl)"
                             alt="@s.Name"
                             class="rounded-circle"
                             style="width:56px;height:56px;object-fit:cover;" />

                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between gap-2">
                                        <div>
                                            <h6 class="mb-1">@s.Name</h6>
                                            <div class="small text-muted">
                                                <i class="bi bi-geo-alt me-1"></i>@s.City
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-2 small text-muted">
                                        @string.Join(" · ", s.Services ?? Enumerable.Empty<string>())
                                    </div>
                                </div>
                            </div>

                            <div class="mt-auto d-flex justify-content-between align-items-center pt-3 border-top">
                                <div class="small text-muted">
                                    @L["FromPrice"]
                                    <strong>
                                        @(s.PricePerDay > 0 ? $"€{s.PricePerDay}" : L["On Request"])
                                    </strong>
                                </div>

                        @if (s.AnnouncementIds != null && s.AnnouncementIds.Any())
                                {
                                    <div class="d-flex gap-2">
                                        <a class="btn btn-brand btn-sm"
                                           asp-controller="Announcement"
                                           asp-action="Details"
                                           asp-route-id="@s.AnnouncementIds.First()">
                                            Ver Anúncio
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </article>
                </div>
            }
        }
    </div>
</section>
