@model MVC_Buddies.Dtos.ProfitReportViewModel

@{
    ViewData["Title"] = "Relatório de Lucros Histórico";
}

<h2 class="mb-4">Relatório de Lucros – @Model.Year</h2>

<div class="row">
    <div class="col-md-4">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title">Lucro Líquido</h5>
                <p class="card-text display-5">@Model.Summary.NetProfit.ToString("C")</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title">Receita Total</h5>
                <p class="card-text display-5">@Model.Summary.TotalRevenue.ToString("C")</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-warning mb-3">
            <div class="card-body">
                <h5 class="card-title">Comissões</h5>
                <p class="card-text display-5">@Model.Summary.TotalCommission.ToString("C")</p>
            </div>
        </div>
    </div>
</div>

<!-- Gráfico histórico -->
<div class="card mt-4">
    <div class="card-body">
        <canvas id="profitChart" height="100"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('profitChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.History.Select(h => h.Period))),
                datasets: [{
                    label: 'Lucro Líquido',
                    data: @Html.Raw(Json.Serialize(Model.History.Select(h => h.NetProfit))),
                    borderColor: '#28a745',
                    tension: 0.1,
                    fill: false
                }, {
                    label: 'Receita',
                    data: @Html.Raw(Json.Serialize(Model.History.Select(h => h.Revenue))),
                    borderColor: '#007bff',
                    tension: 0.1,
                    fill: false
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });
    </script>
}

