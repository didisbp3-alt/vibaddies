@model MVC_Buddies.Dtos.PetOwnerProfileViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IViewLocalizer Localizer

<div class="container mt-5">
    <div class="card shadow-sm rounded-4 border-0">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="mb-0">@Localizer["PetOwnerProfile"]</h3>
                <a asp-action="Edit" asp-route-id="@Model.Id"
                   class="btn btn-outline-primary">
                    @Localizer["EditProfile"]
                </a>
            </div>

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label fw-semibold">@Localizer["Username"]</label>
                    <div class="form-control bg-light">@Model.UserName</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">@Localizer["Email"]</label>
                    <div class="form-control bg-light">@Model.Email</div>
                </div>

            </div>

            <hr class="my-4" />

        </div>
    </div>
</div>