@model List<MVC_Buddies.Dtos.BreedItemDto>
@{
    ViewData["Title"] = "Breeds";
    var species = ViewBag.Species as List<MVC_Buddies.Dtos.RefItemDto> ?? new();
    int speciesId = (int)(ViewBag.SpeciesId ?? 0);
}

<h2 class="mb-3">@ViewData["Title"]</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-8">
        <select class="form-select" name="speciesId" required>
            <option value="0" selected="@(speciesId == 0)">Escolhe uma species...</option>
            @foreach (var s in species)
            {
                <option value="@s.Id" selected="@(s.Id == speciesId)">@s.Name</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <button class="btn btn-primary w-100">Carregar</button>
    </div>
</form>

@if (speciesId == 0)
{
    <div class="alert alert-info">Seleciona uma species para ver/criar breeds.</div>
}
else
{
    <div class="card p-3 mb-3">
        <form asp-action="CreateBreed" method="post" class="row g-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="speciesId" value="@speciesId" />
            <div class="col-md-8">
                <input class="form-control" name="name" placeholder="Nova breed..." required />
            </div>
            <div class="col-md-4">
                <button class="btn btn-primary w-100">Adicionar</button>
            </div>
        </form>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-striped mb-0 align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td>@b.Id</td>
                            <td>
                                <form asp-action="UpdateBreed" method="post" class="d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@b.Id" />
                                    <input type="hidden" name="speciesId" value="@speciesId" />
                                    <input class="form-control" name="name" value="@b.Name" />
                                    <button class="btn btn-outline-primary btn-sm">Guardar</button>
                                </form>
                            </td>
                            <td class="text-end">
                                <form asp-action="DeleteBreed" method="post" class="d-inline"
                                      onsubmit="return confirm('Eliminar breed @b.Name?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@b.Id" />
                                    <input type="hidden" name="speciesId" value="@speciesId" />
                                    <button class="btn btn-outline-danger btn-sm">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
