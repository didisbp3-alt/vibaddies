@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model IEnumerable<MVC_Buddies.Dtos.SkillItemDto>

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">@Localizer["SkillsTitle"]</h2>
            <p class="text-muted mb-0">@Localizer["SkillsSubtitle"]</p>
        </div>

        <a asp-action="CreateSkill" class="btn btn-dark px-4 shadow-sm">
            @Localizer["NewSkill"]
        </a>
    </div>

    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="text-center py-5 border rounded-4 bg-light">
            <h5 class="fw-semibold mb-2">@Localizer["NoSkillsFound"]</h5>
            <p class="text-muted mb-3">@Localizer["NoSkillsSubtitle"]</p>
            <a asp-action="CreateSkill" class="btn btn-dark px-4">
                @Localizer["CreateSkill"]
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var skill in Model)
            {
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">

                    <div class="card border-0 shadow-sm rounded-4 h-100 skill-card">

                        <div class="card-body d-flex flex-column">

                            <!-- Skill Name -->
                            <div class="mb-4">
                                <h5 class="fw-semibold mb-0">@skill.Name</h5>
                            </div>

                            <!-- Actions -->
                            <div class="mt-auto d-flex gap-2">

                                <a asp-action="EditSkill"
                                   asp-route-id="@skill.Id"
                                   class="btn btn-sm btn-outline-secondary w-100">
                                    @Localizer["Edit"]
                                </a>

                                <form asp-action="DeleteSkill" method="post" class="w-100">
                                    <input type="hidden" name="id" value="@skill.Id" />
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger w-100">
                                        @Localizer["Delete"]
                                    </button>
                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>