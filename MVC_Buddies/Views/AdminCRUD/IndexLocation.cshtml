@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model IEnumerable<MVC_Buddies.Dtos.LocationItemDto>

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">@Localizer["LocationsTitle"]</h2>
            <p class="text-muted mb-0">@Localizer["LocationsSubtitle"]</p>
        </div>

        <a asp-action="CreateLocation" class="btn btn-dark px-4 shadow-sm">
            @Localizer["NewLocation"]
        </a>
    </div>

    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="text-center py-5 border rounded-4 bg-light">
            <h5 class="fw-semibold mb-2">@Localizer["NoLocationsFound"]</h5>
            <p class="text-muted mb-3">@Localizer["NoLocationsSubtitle"]</p>
            <a asp-action="CreateLocation" class="btn btn-dark px-4">
                @Localizer["CreateLocation"]
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var location in Model)
            {
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">

                    <div class="card border-0 shadow-sm rounded-4 h-100 location-card">

                        <div class="card-body d-flex flex-column">

                            <!-- Location Name -->
                            <div class="mb-3">
                                <h5 class="fw-semibold mb-1">@location.Name</h5>
                            </div>

                            <!-- Info -->
                            <div class="mb-4">
                                <div class="small text-muted">@Localizer["District"]</div>
                                <div class="fw-semibold mb-2">@location.District</div>

                                <div class="small text-muted">@Localizer["Country"]</div>
                                <div class="fw-semibold">@location.Country</div>
                            </div>

                            <!-- Actions -->
                            <div class="mt-auto d-flex gap-2">

                                <a asp-action="EditLocation"
                                   asp-route-id="@location.Id"
                                   class="btn btn-sm btn-outline-secondary w-100">
                                    @Localizer["Edit"]
                                </a>

                                <form asp-action="DeleteLocation" method="post" class="w-100">
                                    <input type="hidden" name="id" value="@location.Id" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger w-100">
                                        @Localizer["Delete"]
                                    </button>
                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>