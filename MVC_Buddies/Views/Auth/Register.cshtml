@model MVC_Buddies.Dtos.RegisterRequestDto

@{
    ViewData["Title"] = "Registo";
}

<h2 class="mb-4">Criar Conta</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form asp-action="Register" asp-controller="Auth" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="UserName" class="form-label">Nome de utilizador</label>
        <input asp-for="UserName" class="form-control" placeholder="Escolha um nome de utilizador" />
        <span asp-validation-for="UserName" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" placeholder="exemplo@dominio.com" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label">Palavra-passe</label>
        <input asp-for="Password" class="form-control" type="password" />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label">Confirmar palavra-passe</label>
        <input asp-for="ConfirmPassword" class="form-control" type="password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <!-- Escolha do tipo de conta – campo crítico -->
    <div class="mb-4">
        <label class="form-label">Quero registar-me como:</label>
        <div class="d-flex gap-4">
            <div class="form-check">
                <input class="form-check-input" type="radio" asp-for="AccountType" value="PetOwner" id="petowner" required />
                <label class="form-check-label" for="petowner">Dono de Pet (Pet Owner)</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" asp-for="AccountType" value="PetSitter" id="petsitter" required />
                <label class="form-check-label" for="petsitter">Cuidador / Pet Sitter</label>
            </div>
        </div>
        <span asp-validation-for="AccountType" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary btn-lg w-100">
        Registar
    </button>

    <div class="text-center mt-3">
        <small>Já tem conta? <a asp-action="Login" asp-controller="Auth">Iniciar sessão</a></small>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}