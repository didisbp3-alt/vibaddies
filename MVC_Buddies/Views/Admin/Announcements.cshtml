@model MVC_Buddies.Dtos.PagedResult<MVC_Buddies.Dtos.AnnouncementAdminItemVm>
@{
    ViewData["Title"] = "Announcements";
    bool? active = ViewBag.Active as bool?;
}

<h2 class="mb-3">@ViewData["Title"]</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <select class="form-select" name="active">
            <option value="" selected="@(active is null)">Todos</option>
            <option value="true" selected="@(active == true)">Ativos</option>
            <option value="false" selected="@(active == false)">Inativos</option>
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary w-100">Filtrar</button>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped mb-0 align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Descrição</th>
                    <th>Local</th>
                    <th>Criado</th>
                    <th>Status</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Items)
                {
                    <tr>
                        <td>@a.Id</td>
                        <td style="max-width: 520px;">@a.Description</td>
                        <td>@a.Location</td>
                        <td>@a.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (a.IsActive)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else
                            {

                                <span class="badge bg-secondary">Inativo</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="SetAnnouncementActive" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@a.Id" />
                                <input type="hidden" name="isActive" value="@(!a.IsActive)" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button class="btn btn-sm @(a.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    @(a.IsActive ? "Desativar" : "Ativar")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <span class="text-muted">Total: @Model.Total</span>
</div>
