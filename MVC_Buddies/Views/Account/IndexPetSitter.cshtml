@model MVC_Buddies.Dtos.PetSitterProfileViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IViewLocalizer Localizer

<div class="container mt-5">
    <div class="card shadow-sm rounded-4 border-0">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="mb-0">@Localizer["PetSitterProfile"]</h3>
                <a asp-action="Edit" asp-route-id="@Model.Id"
                   class="btn btn-outline-primary">
                    @Localizer["EditProfile"]
                </a>
            </div>

            <div class="row g-4">

                <div class="col-md-4 text-center">
                    <img src="@Model.PhotoUrl"
                         class="img-fluid rounded-4 shadow-sm"
                         style="max-height: 250px; object-fit: cover;" />
                </div>

                <div class="col-md-8">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">@Localizer["Username"]</label>
                            <div class="form-control bg-light">@Model.UserName</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">@Localizer["Email"]</label>
                            <div class="form-control bg-light">@Model.Email</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">@Localizer["FullName"]</label>
                            <div class="form-control bg-light">@Model.FullName</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">@Localizer["Location"]</label>
                            <div class="form-control bg-light">@Model.LocationName</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">@Localizer["YearsExperience"]</label>
                            <div class="form-control bg-light">
                                @Localizer["ExperienceWithYears", Model.YearsExperience]
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">@Localizer["Subscription"]</label>
                            <div class="form-control bg-light">
                                <span class="badge @(Model.SubscriptionType == "Premium" ? "bg-warning text-dark" : "bg-secondary")">
                                    @Model.SubscriptionType
                                </span>
                            </div>
                        </div>

                    </div>

                </div>
            </div>

            <hr class="my-4" />

            <!-- SKILLS -->
            <h5 class="mb-3">@Localizer["Skills"]</h5>
            <div>
                @if (Model.Skills.Any())
                {
                    foreach (var skill in Model.Skills)
                    {
                        <span class="badge bg-primary me-2 mb-2">@skill</span>
                    }
                }
                else
                {
                    <p class="text-muted">@Localizer["NoSkillsAdded"]</p>
                }
            </div>

            <hr class="my-4" />

            <!-- SPECIES -->
            <h5 class="mb-3">@Localizer["Species"]</h5>
            <div>
                @if (Model.Species.Any())
                {
                    foreach (var species in Model.Species)
                    {
                        <span class="badge bg-success me-2 mb-2">@species</span>
                    }
                }
                else
                {
                    <p class="text-muted">@Localizer["NoSpeciesSelected"]</p>
                }
            </div>

        </div>
    </div>
</div>