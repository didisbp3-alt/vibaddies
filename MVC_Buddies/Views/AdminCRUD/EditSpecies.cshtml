@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model MVC_Buddies.Dtos.SpeciesItemDto

<h2>@Localizer["EditSpeciesTitle"]</h2>

<form asp-action="EditSpecies">

    <input type="hidden" asp-for="Id" />

    <input asp-for="Name" class="form-control mb-3" />

    <button class="btn btn-success">
        @Localizer["Save"]
    </button>

</form>

<a asp-action="IndexSpecies" class="btn btn-secondary flex-fill">
    @Localizer["Cancel"]
</a>