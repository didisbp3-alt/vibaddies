@model IEnumerable<MVC_Buddies.Dtos.PetDto>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="container mt-4">
    <div class="row g-4">

        @foreach (var p in Model)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 d-flex">

                <article class="card h-100 shadow-sm rounded-4 border-0 w-100">
                    <div class="card-body d-flex flex-column">

                        <!-- Header -->
                        <div class="mb-3">
                            <h5 class="mb-1">@p.Name</h5>

                            <div class="small text-muted">
                                Breed: @p.BreedName
                            </div>

                            <div class="mt-2">
                                <span class="badge bg-light text-dark border">
                                    Age: @p.Age
                                </span>
                            </div>
                        </div>

                        <!-- Info -->
                        <div class="flex-grow-1 small text-muted">
                            <div>Owner: @p.OwnerFullName</div>

                            <div class="mt-2">
                                Special Needs:
                                <strong>
                                    @(p.HasSpecialNeeds ? "Yes" : "No")
                                </strong>
                            </div>
                        </div>

                        <!-- Footer -->
                        <div class="mt-auto d-flex gap-2">
                            <a class="btn btn-brand btn-sm"
                               asp-controller="Pet"
                               asp-action="Edit"
                               asp-route-id="@p.Id">
                                Edit
                            </a>

                            <a class="btn btn-brand btn-sm"
                               asp-controller="Pet"
                               asp-action="Delete"
                               asp-route-id="@p.Id">
                                Delete
                            </a>
                        </div>

                    </div>
                </article>

            </div>
        }



    </div>
</div>
<a class="btn btn-brand btn-sm"
   asp-controller="Pet"
   asp-action="Create">
    Add Pet
</a>