@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Options
@inject IOptions<RequestLocalizationOptions> LocOptions

@{
    var rqf = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = rqf?.RequestCulture.UICulture.Name ?? "pt-PT";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    // Páginas onde não mostramos botões de login/registo
    var isAuthPage =
        string.Equals(currentController, "Auth", StringComparison.OrdinalIgnoreCase) &&
        (string.Equals(currentAction, "Login", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(currentAction, "Register", StringComparison.OrdinalIgnoreCase));
}

<!doctype html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"] - Buddies2Buddies</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>

<body>
<header class="border-bottom bg-white">
    <nav class="navbar navbar-expand-lg container py-2">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Buddies</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topnav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="topnav">
            <!-- LEFT -->
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">
                        Encontrar cuidador
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Announcement" asp-action="Index">
                        Anúncios
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="HowItWorks">
                        Como funciona
                    </a>
                </li>
                   
            </ul>

            <!-- RIGHT -->
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                 
                  
                   
                 
                  
                <!-- 🌍 Language switch (estratégico: sempre visível, à direita) -->
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle"
                       href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"
                       title="Language">
                        <i class="bi bi-translate me-1"></i>
                        @(currentCulture.StartsWith("pt") ? "PT" : "EN")
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <form asp-controller="Culture" asp-action="Set" method="post" class="px-3 py-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="culture" value="pt-PT" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button class="btn btn-link p-0 text-decoration-none">Português</button>
                            </form>
                        </li>
                        <li>
                            <form asp-controller="Culture" asp-action="Set" method="post" class="px-3 py-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="culture" value="en-US" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button class="btn btn-link p-0 text-decoration-none">English</button>
                            </form>
                        </li>
                    </ul>
                </li>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- 👤 User dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center"
                           href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle me-2"></i>
                            <span class="fw-semibold">@User.Identity.Name</span>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end">
                                @if (User.IsInRole("PetSitter") || User.IsInRole("PetOwner"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Index">
                                            <i class="bi bi-person me-2"></i> Meu Perfil
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item" asp-controller="Booking" asp-action="MyBookings">
                                            <i class="bi bi-calendar-check me-2"></i> Minhas Reservas
                                        </a>
                                    </li>
                                }

                                 @if (User.IsInRole("PetSitter") )
                                 {
                                 
                                    <li>
                                        <a class="dropdown-item" asp-controller="Announcement" asp-action="MyAnnouncements">
                                            <i class="bi bi-chat-dots-fill"></i>Meus Anúncios
                                        </a>
                                    </li>

                                <li>
                                        <a class="dropdown-item" asp-controller="Reviews" asp-action="Index">
                                            <i class="bi bi-star-half"></i>Minhas Avaliações
                                    </a>
                                </li>
                                 }


                                @if (User.IsInRole("PetOwner"))
                                {

                                    <li>
                                        <a class="dropdown-item" asp-controller="Pet" asp-action="Index">
                                            <i class="bi bi-heart-fill"></i>Meu Pets
                                        </a>
                                    </li>
                                }


                            @* Exemplo: só Admin *@
                            @if (User.IsInRole("Admin"))
                            {
                                <li>
                                        <a class="dropdown-item" asp-controller="AdminCRUD" asp-action="Index">
                                            <i class="bi bi-gear"></i> Gestão 
                                    </a>
                                </li>

                                
                                 <li>
                                        <a class="dropdown-item" asp-controller="Reports" asp-action="Profits">
                                                <i class="bi bi-graph-up-arrow me-2"></i> Reports
                                 </a>
                               </li>
                            }

                            <li><hr class="dropdown-divider" /></li>

                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="px-3 py-1">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-outline-danger btn-sm w-100">
                                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    @* ✅ Não mostrar botões em Login/Register *@
                    if (!isAuthPage)
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-secondary btn-sm"
                               asp-controller="Auth" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Login
                            </a>
                        </li>

                        
                    }
                }
            </ul>
        </div>
    </nav>
</header>

<main class="container py-4">
    @RenderBody()
</main>

<footer class="border-top mt-5">
    <div class="container py-4 d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <div class="text-muted small">© @DateTime.Now.Year Buddies2Buddies</div>
        <div class="small">
            <a class="text-decoration-none me-3" asp-controller="Legal" asp-action="Privacy">Privacidade</a>
            <a class="text-decoration-none" asp-controller="Legal" asp-action="Terms">Termos</a>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>


