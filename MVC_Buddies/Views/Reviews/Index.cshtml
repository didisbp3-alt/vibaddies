@model List<MVC_Buddies.Dtos.ReviewDto>

@{
    ViewData["Title"] = "My Reviews";
}

<h2 class="mb-4">My Reviews</h2>

@if (!Model.Any())
{
    <div class="alert alert-light border rounded-4 shadow-sm">
        No reviews yet.
    </div>
}
else
{
    <div class="row g-4">

        @foreach (var r in Model)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 d-flex">

                <article class="card h-100 shadow-sm rounded-4 border-0 w-100">
                    <div class="card-body d-flex flex-column">

                        <!-- Header -->
                        <div class="mb-3">
                            <h6 class="mb-1">@r.PetName</h6>

                            <div class="small text-muted">
                                @r.CreatedAt
                            </div>
                        </div>

                        <!-- Services -->
                        <div class="mb-2">
                            @if (r.Services != null && r.Services.Any())
                            {
                                foreach (var s in r.Services)
                                {
                                    <span class="badge bg-secondary me-1">@s</span>
                                }
                            }
                        </div>

                        <!-- Comment -->
                        <div class="flex-grow-1 small">
                            @r.Comment
                        </div>

                        <!-- Footer -->
                        <div class="mt-auto pt-3 border-top">
                            <form asp-action="Delete" method="post">
                                <input type="hidden" name="id" value="@r.Id" />

                                <button type="submit"
                                        class="btn btn-outline-danger btn-sm w-100">
                                    Delete Review
                                </button>
                            </form>
                        </div>

                    </div>
                </article>

            </div>
        }

    </div>
}
